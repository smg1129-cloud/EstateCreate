# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---
# Local dev matches docker-compose.yml. In production, point at an AWS RDS
# Postgres instance provisioned under a signed BAA.
DATABASE_URL="postgresql://telehealth:telehealth_dev_password@localhost:5432/telehealth_clinic?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# 32-byte (base64) key used to encrypt sensitive-at-rest fields (e.g. MFA
# secrets) at the application layer, in addition to storage-level encryption.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="replace-with-a-random-32-byte-key"

# --- Video visits ---
# Leave VIDEO_PROVIDER=mock for local dev with no real Daily account.
# Daily.co offers a HIPAA BAA on qualifying plans — confirm one is signed
# before any real visit uses this.
VIDEO_PROVIDER="mock" # "mock" | "daily"
DAILY_API_KEY=""

# --- Payments ---
# Leave PAYMENTS_PROVIDER=mock for local dev with no real Stripe account.
# A production Stripe account used for healthcare billing should be covered
# by Stripe's BAA (available on qualifying plans) before handling real data.
PAYMENTS_PROVIDER="mock" # "mock" | "stripe"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- E-prescribing ---
# No real adapter is implemented — see COMPLIANCE.md. Controlled-substance
# e-prescribing (EPCS) requires a DEA-audited certified vendor
# (e.g. DoseSpot, NewCrop), not a self-built integration.
PRESCRIBING_PROVIDER="mock" # "mock" only, until a certified vendor is contracted

# --- App ---
NODE_ENV="development"
SESSION_IDLE_TIMEOUT_MINUTES="15"
