# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---
# Local dev matches docker-compose.yml. In production, point at a managed
# Postgres instance (encrypted at rest) under an appropriate data-processing
# agreement — this database holds privileged client information.
DATABASE_URL="postgresql://estatecreate:estatecreate_dev_password@localhost:5432/estatecreate?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# 32-byte (base64) key used to encrypt sensitive-at-rest fields (e.g. MFA
# secrets) at the application layer, in addition to storage-level encryption.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="replace-with-a-random-32-byte-key"

# --- Social login (OAuth) ---
# All optional. A provider's button only appears once BOTH of its variables are
# set — leave a provider blank to hide it. Social login is for CLIENTS only;
# staff always use email + password + TOTP. In every provider's console set the
# redirect/callback URL to:  {NEXTAUTH_URL}/api/auth/callback/<provider>
# e.g. https://estate.grocloud.one/api/auth/callback/google
# See docs/ops/auth-providers.md for step-by-step setup.

# Google — Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft (Entra ID / Azure AD) — Entra admin center → App registrations.
# Tenant "common" allows work/school + personal accounts; set a directory
# (tenant) id to restrict to one organization.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# Apple (Sign in with Apple) — the client secret is a signed ES256 JWT we mint
# at runtime from your .p8 key, so supply the four components below (not a
# static secret). APPLE_CLIENT_ID is the Services ID. Store the .p8 contents in
# APPLE_PRIVATE_KEY with literal \n between lines, or paste real newlines.
# (Advanced: set APPLE_CLIENT_SECRET to a pre-generated JWT to bypass minting.)
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# APPLE_CLIENT_SECRET=""

# Facebook — Meta for Developers → your app → Facebook Login → Settings.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Document storage ---
# Where rendered DOCX/PDF artifacts are written. The "local" adapter writes
# under .data/ (git-ignored) for development. In production use an object
# store (S3 + SSE-KMS) via a real adapter.
DOC_STORAGE_PROVIDER="local" # "local" | "s3"
DOC_STORAGE_DIR=".data/documents"

# --- E-signature / Remote Online Notarization (RON) ---
# Leave ESIGN_PROVIDER=mock for local dev. Florida RON has strict statutory
# requirements (Fla. Stat. 117.201 et seq.); wills executed via RON must
# follow the electronic-will rules in Fla. Stat. ch. 732 part II. Confirm the
# vendor is a Florida-registered online notary platform before going live.
ESIGN_PROVIDER="mock" # "mock" | "notarize" | "docusign"
ESIGN_API_KEY=""
ESIGN_WEBHOOK_SECRET=""

# --- App ---
NODE_ENV="development"
SESSION_IDLE_TIMEOUT_MINUTES="15"
