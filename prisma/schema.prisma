// EstateCreate — automated Florida estate-planning data model.
//
// Design notes (see COMPLIANCE.md and README.md for the full rationale):
// - Documents are generated deterministically from questionnaire answers by
//   a coded template/clause engine (src/lib/documents), never by an LLM. The
//   raw generated content is stored as a structured block model (contentJson)
//   so a document can always be re-rendered to DOCX/PDF/HTML and diffed.
// - Nothing legally significant is hard-deleted. GeneratedDocument versions
//   are superseded, never overwritten; AuditLog is append-only; reviews and
//   signature events accumulate. Estate documents carry retention and
//   malpractice-defense weight, so deletion policy needs human/legal sign-off.
// - The attorney review gate is a hard requirement: a document cannot be
//   released to a client or sent for signature until an ATTORNEY has APPROVED
//   that specific version. Enforced in the data-access layer, not just the UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PARALEGAL
  ATTORNEY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  // Firm-level defaults that flow into generated documents.
  stateCode  String   @default("FL")
  barName    String?  // e.g. "The Florida Bar"
  createdAt  DateTime @default(now())

  users      User[]
  matters    EstateMatter[]
  documentPrices DocumentPrice[]
}

/// Identity + credentials. One row per human who can log in, regardless of role.
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email          String       @unique
  // Nullable: a client who signs up purely through a social provider
  // (Google/Apple/Microsoft/Facebook) never sets a password. Staff always
  // have one — social login is refused for staff roles (see src/lib/auth.ts).
  passwordHash   String?
  role           Role
  status         UserStatus   @default(ACTIVE)

  // Avatar URL supplied by a social provider, if any.
  image          String?
  // OAuth providers this user has linked (e.g. ["google","apple"]). Used to
  // show the client which sign-in methods are attached to their account and to
  // avoid duplicate-linking. Credentials login is implied by a non-null
  // passwordHash and is not listed here.
  authProviders  String[]     @default([])

  // TOTP MFA — required for staff-side roles (PARALEGAL/ATTORNEY/ADMIN),
  // optional for CLIENT. Secret is encrypted at the application layer
  // (src/lib/encryption.ts) before storage.
  mfaEnabled     Boolean      @default(false)
  mfaSecretEnc   String?

  firstName      String
  lastName       String
  phone          String?
  // Bar number for attorneys; surfaces on documents they approve.
  barNumber      String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastLoginAt    DateTime?

  clientMatters    EstateMatter[]     @relation("MatterClient")
  assignedMatters  EstateMatter[]     @relation("MatterAttorney")
  reviews          DocumentReview[]   @relation("ReviewReviewer")
  auditLogs        AuditLog[]         @relation("AuditActor")
  consents         ConsentRecord[]    @relation("ConsentUser")

  @@index([organizationId])
  @@index([role])
}

enum MatterStatus {
  INTAKE            // client is filling questionnaires
  READY_TO_GENERATE // intake complete, awaiting/queued for generation
  AWAITING_PAYMENT  // quote presented; documents not generated until paid
  IN_REVIEW         // documents generated, attorney reviewing
  CHANGES_REQUESTED // attorney sent it back; client/paralegal to revise
  APPROVED          // all documents approved by an attorney
  EXECUTION         // out for signature / RON
  COMPLETED         // executed documents delivered
  ABANDONED
}

enum PlanType {
  UNDETERMINED
  WILL_BASED
  TRUST_BASED
}

/// The estate-planning engagement for one client. Anchors the questionnaires,
/// the generated document set, review, and signing.
model EstateMatter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId       String
  client         User         @relation("MatterClient", fields: [clientId], references: [id])

  // Assigned reviewing attorney (nullable until triaged/assigned).
  attorneyId     String?
  attorney       User?        @relation("MatterAttorney", fields: [attorneyId], references: [id])

  reference      String       @unique // human-facing matter number, e.g. "EC-2026-000123"
  status         MatterStatus @default(INTAKE)
  planType       PlanType     @default(UNDETERMINED)

  // Cached output of the triage rules engine: which document types this
  // client should receive, plus the rationale/flags. Recomputed on intake
  // changes; the authoritative source is always the questionnaire answers.
  recommendedDocTypes String[] @default([])
  planSummary    Json?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  questionnaires QuestionnaireResponse[]
  documents      GeneratedDocument[]
  consents       ConsentRecord[]
  quotes         Quote[]
  payments       Payment[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([attorneyId])
}

// ---- Billing --------------------------------------------------------------
// Per-document flat-fee model. Documents are NOT generated until the client
// pays for the selected set (the payment gate lives in the matter service).

/// Firm-configurable flat fee for one document type. Admin-editable so the
/// firm sets its own pricing without a code change. Amounts are in the
/// smallest currency unit (cents) to avoid floating-point money.
model DocumentPrice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  type        DocumentType
  amountCents Int          @default(0)
  currency    String       @default("usd")
  active      Boolean      @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([organizationId, type])
}

enum QuoteStatus {
  DRAFT            // being assembled / edited by the client
  AWAITING_PAYMENT // presented, selection locked for checkout
  PAID             // payment succeeded; generation released
  CANCELLED        // superseded by a newer quote or abandoned
}

/// A price quote for a matter: the selectable set of documents and the fee for
/// each. Rebuilt from the rules engine after triage (base set) and again after
/// the detailed questionnaire (adds proposed documents). Preserves the client's
/// accept/reject selections across rebuilds. One quote is active per matter.
model Quote {
  id            String       @id @default(cuid())
  matterId      String
  matter        EstateMatter @relation(fields: [matterId], references: [id])

  status        QuoteStatus  @default(DRAFT)
  currency      String       @default("usd")
  // Snapshot of the sum of selected line items at last (re)build / checkout.
  subtotalCents Int          @default(0)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items         QuoteItem[]
  payments      Payment[]

  @@index([matterId, status])
}

enum LineItemOrigin {
  BASE     // recommended from the triage questionnaire (pre-selected)
  PROPOSED // suggested by the detailed questionnaire (opt-in)
}

/// One document line on a quote. Price is snapshotted at build time so a later
/// catalog change does not silently alter an outstanding quote.
model QuoteItem {
  id            String         @id @default(cuid())
  quoteId       String
  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  type          DocumentType
  label         String
  origin        LineItemOrigin @default(BASE)
  selected      Boolean        @default(true)
  unitPriceCents Int           @default(0)

  @@unique([quoteId, type])
}

enum PaymentStatus {
  PENDING   // checkout started, not yet confirmed
  SUCCEEDED // funds captured
  FAILED    // provider reported failure / cancelled
  REFUNDED  // captured then refunded (e.g. attorney could not serve)
}

/// A payment attempt against a quote. Handled through the payments adapter
/// (mock by default; a real processor added behind the same interface).
model Payment {
  id            String        @id @default(cuid())
  quoteId       String
  quote         Quote         @relation(fields: [quoteId], references: [id])
  matterId      String
  matter        EstateMatter  @relation(fields: [matterId], references: [id])

  provider      String        // "mock" | "stripe" | ...
  externalRef   String?       // provider session / payment intent id
  amountCents   Int
  currency      String        @default("usd")
  status        PaymentStatus @default(PENDING)

  // Which document types this payment covers (the selected set at checkout).
  paidForTypes  DocumentType[] @default([])

  refundReason  String?
  refundedAt    DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([matterId])
  @@index([externalRef])
}

enum QuestionnaireKind {
  TRIAGE        // "what do you need" — identifies the plan type
  ESTATE_INTAKE // full estate/asset/family/wishes questionnaire
}

/// A completed (or in-progress) questionnaire for a matter. Answers are stored
/// as JSON keyed by the question id defined in src/lib/questionnaire/schema.ts.
/// A new submission bumps `version` rather than overwriting, so we retain what
/// the client actually answered at the time a given document version was built.
model QuestionnaireResponse {
  id          String            @id @default(cuid())
  matterId    String
  matter      EstateMatter      @relation(fields: [matterId], references: [id])

  kind        QuestionnaireKind
  version     Int               @default(1)
  answers     Json              // { [questionId]: value }
  // Section id -> completed? — drives the progress UI and "can generate" gate.
  progress    Json?
  completedAt DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([matterId, kind, version])
  @@index([matterId, kind])
}

enum DocumentType {
  LAST_WILL
  REVOCABLE_LIVING_TRUST
  POUR_OVER_WILL
  DURABLE_POWER_OF_ATTORNEY
  HEALTH_CARE_SURROGATE
  LIVING_WILL
  HIPAA_AUTHORIZATION
  SPECIAL_NEEDS_TRUST
  PERSONAL_PROPERTY_MEMORANDUM
  PRENEED_GUARDIAN_DESIGNATION
  CERTIFICATE_OF_TRUST
  MARITAL_TRUST
  QDOT_TRUST
  IRREVOCABLE_LIFE_INSURANCE_TRUST
  PET_TRUST
  GUN_TRUST
}

enum DocumentStatus {
  DRAFT             // generated, not yet submitted for review
  IN_REVIEW         // submitted to an attorney
  CHANGES_REQUESTED // attorney requested changes
  APPROVED          // approved by an attorney (releasable / signable)
  REJECTED          // attorney rejected this version outright
  SUPERSEDED        // replaced by a newer generated version
  EXECUTED          // signed/notarized
}

/// One generated document version. The deterministic engine writes
/// `contentJson` (the block model); renderers turn that into docx/pdf/html.
/// `contentHash` lets us detect whether a regeneration actually changed
/// anything the attorney already reviewed.
model GeneratedDocument {
  id            String         @id @default(cuid())
  matterId      String
  matter        EstateMatter   @relation(fields: [matterId], references: [id])

  type          DocumentType
  version       Int            @default(1)
  status        DocumentStatus @default(DRAFT)

  title         String
  contentJson   Json           // DocumentModel from src/lib/documents/blocks.ts
  contentHash   String         // sha256 of the normalized model
  engineVersion String         // generator/version stamp for reproducibility

  // Which questionnaire version this was built from — reproducibility.
  builtFromQuestionnaireId String?

  // Storage keys for rendered artifacts. In production these point at
  // encrypted object storage (S3 + SSE-KMS); in dev the storage adapter
  // writes under .data/ (git-ignored). Bytes never live in the database.
  docxKey       String?
  pdfKey        String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  reviews       DocumentReview[]
  signature     SignatureRequest?

  @@unique([matterId, type, version])
  @@index([matterId, status])
}

enum ReviewDecision {
  SUBMITTED         // sent for review (no decision yet)
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

/// Append-only review trail for a specific document version. Clause-level
/// notes are stored in `annotations` (array of { blockRef, comment }).
model DocumentReview {
  id          String            @id @default(cuid())
  documentId  String
  document    GeneratedDocument @relation(fields: [documentId], references: [id])

  reviewerId  String
  reviewer    User              @relation("ReviewReviewer", fields: [reviewerId], references: [id])

  decision    ReviewDecision
  comment     String?
  annotations Json?             // [{ blockRef, comment }]

  createdAt   DateTime          @default(now())

  @@index([documentId, createdAt])
}

enum ExecutionMethod {
  REMOTE_ONLINE_NOTARIZATION
  IN_PERSON
}

enum SignatureStatus {
  NOT_STARTED
  SENT
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

/// Tracks the execution (signing/notarization) of an APPROVED document via
/// the e-sign / RON adapter (src/lib/esign). No document may enter this stage
/// unless its status is APPROVED — enforced in the data-access layer.
model SignatureRequest {
  id              String            @id @default(cuid())
  documentId      String            @unique
  document        GeneratedDocument @relation(fields: [documentId], references: [id])

  method          ExecutionMethod
  provider        String            // adapter name, e.g. "mock" | "notarize"
  externalRef     String?           // vendor-side envelope/session id
  status          SignatureStatus   @default(NOT_STARTED)

  // Signers, witnesses, and notary as recorded/required. FL execution rules
  // (two witnesses + notary for a self-proved will; RON per Fla. Stat.
  // 117.201 et seq.) are captured in signers + the execution checklist.
  signers         Json              // [{ role, name, email, status, signedAt }]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  completedAt     DateTime?

  events          SignatureEvent[]
}

/// Append-only log of signing lifecycle events from the adapter/webhook.
model SignatureEvent {
  id                 String           @id @default(cuid())
  signatureRequestId String
  signatureRequest   SignatureRequest @relation(fields: [signatureRequestId], references: [id])

  type               String           // e.g. "SENT", "VIEWED", "SIGNED", "NOTARIZED", "COMPLETED"
  actor              String?          // signer/notary identifier
  payload            Json?
  createdAt          DateTime         @default(now())

  @@index([signatureRequestId, createdAt])
}

enum ConsentType {
  ENGAGEMENT_LETTER          // scope/limitations of the automated service
  ELECTRONIC_RECORDS_CONSENT // E-SIGN / UETA consent to electronic docs
  PRIVACY_NOTICE
  TERMS_OF_SERVICE
}

/// Signed consent/acknowledgment records. The engagement + electronic-records
/// consents are captured before intake begins. Never edited or overwritten —
/// a re-consent creates a new row with a bumped version.
model ConsentRecord {
  id         String       @id @default(cuid())

  userId     String
  user       User         @relation("ConsentUser", fields: [userId], references: [id])

  matterId   String?
  matter     EstateMatter? @relation(fields: [matterId], references: [id])

  type       ConsentType
  version    String        // ties to the exact text shown, e.g. "2026-09-v1"
  signedAt   DateTime      @default(now())
  ipAddress  String?

  @@index([userId, type])
}

/// Append-only audit trail. Every view/mutation of a matter, questionnaire,
/// document, review, or signature goes through src/lib/audit.ts, which writes
/// here. Nothing in the app updates or deletes rows in this table.
model AuditLog {
  id         String   @id @default(cuid())

  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  action     String   // "VIEW" | "CREATE" | "UPDATE" | "GENERATE" | "APPROVE" | ...
  entityType String   // "EstateMatter" | "GeneratedDocument" | ...
  entityId   String?

  ipAddress  String?
  userAgent  String?
  metadata   Json?

  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
