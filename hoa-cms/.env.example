# Local Postgres (docker-compose up -d)
DATABASE_URL="postgresql://hoacms:hoacms_dev_only@localhost:5432/hoacms"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Session idle timeout (minutes) for staff roles
SESSION_IDLE_TIMEOUT_MINUTES=15

# Adapters — leave unset to use the mock implementation.
CERTIFIED_MAIL_PROVIDER=mock
DOCUMENT_STORAGE_PROVIDER=mock
BILLING_SYNC_PROVIDER=mock

# Local-disk mock document storage target (gitignored)
DOCUMENT_STORAGE_LOCAL_DIR=./uploads
